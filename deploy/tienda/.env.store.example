# Copiar a la raíz del proyecto como `.env.store` (no se versiona) y completar. Ver docs/azure.md.

# Base de datos local de la tienda (contenedor store_db). Elige una contraseña larga y propia.
DB_NAME=karen_tienda
DB_USER=karen_tienda
DB_PASSWORD=

# Distintos entre sí, 32+ caracteres aleatorios.
STORE_JWT_SECRET=

# Debe ser IDÉNTICA a la que imprime deploy/azure/deploy.ps1 (STORE_SERVICE_KEY).
STORE_SERVICE_KEY=

# URL del portal en Azure que imprime deploy.ps1, sin barra final.
PORTAL_URL=https://karen-portal.example.azurecontainerapps.io

# Dirección donde escucha el puerto 4000. Con la API pública detrás de un proxy o túnel con TLS:
# 127.0.0.1. Si también se usa por la LAN, la IP fija de esta PC (reservarla en el router).
# Nunca 0.0.0.0.
STORE_BIND=127.0.0.1

# Orígenes desde los que se abre la API (obligatorio en producción; separados por comas, sin `*`).
# La URL pública de la tienda y, si se usa por la LAN, http://<IP de la tienda>:4000.
STORE_CORS_ORIGINS=https://tienda.example.com

# La API es pública detrás de un proxy o túnel: el número exacto de saltos (normalmente 1).
# Con 0 todos los clientes comparten IP en los límites de tasa.
STORE_TRUST_PROXY_HOPS=1

# Opcional: promociones con IA.
GEMINI_API_KEY=
