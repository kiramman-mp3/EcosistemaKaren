{
  "name": "ecosistema-karen-backend",
  "version": "1.0.0",
  "description": "Backend comercial y logístico para Supermercado Karen (Fase 1: Inventario Maestro, FEFO, Anti-Overbooking, SSE, Gemini IA, Swagger)",
  "main": "index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "node --test test/*.test.js",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "test:endpoints": "node scripts/test-endpoints.js"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "swagger-ui-express": "^5.0.1"
  },
  "overrides": {
    "proxy-addr": "2.0.8"
  }
}
