{
  "name": "ecosistema-karen-backend",
  "version": "1.0.0",
  "description": "Backend comercial y logístico para Supermercado Karen (Fase 1: Inventario Maestro, FEFO, Anti-Overbooking, SSE, Gemini IA, Swagger)",
  "main": "index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "start:store": "node index.store.js",
    "start:portal": "node index.portal.js",
    "dev:store": "node --watch index.store.js",
    "dev:portal": "node --watch index.portal.js",
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "test:endpoints": "node scripts/test-endpoints.js",
    "test:performance": "node scripts/performance-smoke.js",
    "db:seed": "node scripts/seed.js"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "overrides": {
    "proxy-addr": "2.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "supertest": "^7.3.1"
  }
}
