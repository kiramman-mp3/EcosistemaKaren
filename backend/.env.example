PORT=4000
NODE_ENV=development

# PostgreSQL Configuration (Docker Compose exposed port)
DB_HOST=localhost
DB_PORT=5433
DB_EXPOSED_PORT=5433
DB_NAME=ecosistema_karen
DB_USER=karen_user
DB_PASSWORD=karen_pass

# Base de datos de portal-api (ADR-003). Solo hace falta al ejecutar store-api y portal-api por
# separado: levantar `docker compose --profile split up -d` y descomentar estas variables.
# Cada valor que falte cae en el DB_* correspondiente (el monolito ignora este bloque).
# PORTAL_DB_HOST=localhost
# PORTAL_DB_PORT=5434
# PORTAL_DB_EXPOSED_PORT=5434
# PORTAL_DB_NAME=ecosistema_karen_portal
# PORTAL_DB_USER=karen_portal
# PORTAL_DB_PASSWORD=karen_portal_pass

# TLS hacia la base (obligatorio en Azure Database for PostgreSQL / Supabase): true | no-verify.
# Sin definir, la conexión no se cifra. PORTAL_DB_SSL aplica solo al portal.
# DB_SSL=true
# CA propia para verificar el certificado (PEM o ruta a un archivo); Supabase la necesita.
# DB_SSL_CA=/ruta/prod-ca-2021.crt
# PORTAL_DB_SSL=true

# Optional pgAdmin host port
PGADMIN_PORT=5051
PGADMIN_DEFAULT_EMAIL=admin@karen.com
PGADMIN_DEFAULT_PASSWORD=change_me_for_local_use

JWT_SECRET=change_me_with_a_long_random_secret
# Costo de bcrypt (10 a 14, por defecto 12). Las cuentas con un costo menor se actualizan al iniciar sesión.
# BCRYPT_ROUNDS=12
CORS_ORIGINS=https://portal.karen.example
# Cuántos proxies inversos hay delante de la API (0 = ninguno). Si hay uno y se deja en 0, todos los
# clientes comparten una IP en los límites de tasa. Producción avisa si no se configura.
TRUST_PROXY_HOPS=0
JSON_BODY_LIMIT=100kb
# Registro de accesos en JSON (una línea por petición, sin cabeceras ni cuerpos). Por defecto solo en
# producción; true/false lo fuerza.
ACCESS_LOG=

# Límites por IP. Ajustar con métricas reales, no desactivar en producción.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
RESERVATION_RATE_LIMIT_WINDOW_MS=60000
RESERVATION_RATE_LIMIT_MAX=60
AI_RATE_LIMIT_WINDOW_MS=300000
AI_RATE_LIMIT_MAX=10

# Swagger se habilita automáticamente solo en desarrollo.
SWAGGER_ENABLED=false
SWAGGER_API_URL=https://api.karen.example/api/v1
SWAGGER_USERNAME=
SWAGGER_PASSWORD=

# Reservas se bloquean si la tienda no reporta un latido dentro de este intervalo
HEARTBEAT_TIMEOUT_SECONDS=30
# Canal interno tienda -> portal (ADR-003). Solo hace falta al ejecutar store-api y portal-api por separado.
# STORE_SERVICE_KEY: mismo secreto aleatorio (32+ caracteres) en ambos servicios.
STORE_SERVICE_KEY=change_me_with_another_long_random_secret
# PORTAL_URL: dónde envía store-api el latido (https en producción).
PORTAL_URL=http://localhost:4001
STORE_ID=tienda-principal
# false desactiva el envío del latido desde la tienda
HEARTBEAT_ENABLED=true
# Sincronización del catálogo tienda -> portal (misma PORTAL_URL y STORE_SERVICE_KEY).
# La tienda revisa cambios cada CATALOG_SYNC_INTERVAL_SECONDS (mín. 5) y reenvía todo cada
# CATALOG_RESYNC_SECONDS (mín. 30). El portal marca la copia como vieja pasados CATALOG_STALE_SECONDS
# (mín. 60; debe ser mayor que CATALOG_RESYNC_SECONDS). INTERNAL_BODY_LIMIT limita los snapshots.
CATALOG_SYNC_ENABLED=true
CATALOG_SYNC_INTERVAL_SECONDS=15
CATALOG_RESYNC_SECONDS=600
CATALOG_STALE_SECONDS=1200
INTERNAL_BODY_LIMIT=10mb
# Fotos de productos tienda -> portal (viajan por el mismo canal que el catálogo). MEDIA_DIR es la carpeta
# de fotos de la tienda; vacío usa backend/public/media.
MEDIA_SYNC_ENABLED=true
MEDIA_SYNC_INTERVAL_SECONDS=60
MEDIA_DIR=
# Reservas entre portal y tienda: la tienda pide comandos al portal con long-poll de
# RESERVATION_POLL_WAIT_SECONDS (5-30) y el portal espera RESERVATION_SYNC_WAIT_SECONDS (0-25)
# la respuesta de la tienda antes de responder 202.
# Limpieza periódica de tablas de apoyo (tokens revocados, límites de tasa, comandos de reserva resueltos).
MAINTENANCE_INTERVAL_MINUTES=60
RETENTION_DAYS=30
RESERVATION_QUEUE_ENABLED=true
RESERVATION_POLL_WAIT_SECONDS=25
RESERVATION_SYNC_WAIT_SECONDS=8

# Zona horaria del negocio: define el "día" de caducidades, alertas FEFO y CURRENT_DATE
BUSINESS_TIMEZONE=America/Guayaquil

# Google Gemini AI API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=10000
# Reintentos ante 503/504/timeouts; el último intento usa GEMINI_FALLBACK_MODEL si está definido
GEMINI_MAX_ATTEMPTS=3
GEMINI_RETRY_DELAY_MS=500
GEMINI_FALLBACK_MODEL=
GEMINI_CACHE_TTL_SECONDS=900
GEMINI_CACHE_MAX_ENTRIES=1000
