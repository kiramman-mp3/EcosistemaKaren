# store-api (la red local de la tienda). Con un solo backend es el mismo puerto que el portal; con
# `node start.js --split` es el 4000 y el portal móvil usa el 4001.
EXPO_PUBLIC_API_URL=http://IP_LOCAL_DE_LA_PC:4000/api/v1

# Datos de la empresa para los reportes (opcionales). Sin ellos se usan los de src/config/storeInfo.ts.
# EXPO_PUBLIC_STORE_TRADE_NAME=Supermercado Karen
# EXPO_PUBLIC_STORE_LEGAL_NAME=Patricia Rodríguez
# EXPO_PUBLIC_STORE_RUC=1850410612001
# EXPO_PUBLIC_STORE_ADDRESS=Av. 17 de Abril y García Moreno
# EXPO_PUBLIC_STORE_CITY=Quero, Tungurahua
