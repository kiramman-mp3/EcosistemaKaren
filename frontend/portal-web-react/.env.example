# Solo hace falta si /api/v1 no pasa por un proxy inverso (producción).
# Debe apuntar a portal-api: el portal web nunca habla con la red local de la tienda.
# VITE_API_URL=https://api.karen.example/api/v1

# Desarrollo: destino del proxy de vite para /api (por defecto http://localhost:4000).
# `node start.js --split` lo fija a portal-api.
# VITE_PROXY_TARGET=http://localhost:4001
